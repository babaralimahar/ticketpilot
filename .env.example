# Copy to .env for local development. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Local compose database (docker compose up -d db)
# (host port 5433, so it does not clash with another Postgres on 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5436/app
# Integration tests use a separate database they drop and recreate:
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5436/app_test

# LLM: "fake" costs nothing. For a real provider with an OpenAI-compatible API:
LLM_PROVIDER=fake
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id        # must also be listed in config/pricing.yaml
# LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Tracing: start jaeger with docker compose, then uncomment
# OTEL_ENDPOINT=http://localhost:4318/v1/traces

# off | embedded (inside the web process) | standalone (python -m app.worker)
WORKER_MODE=embedded


# Embeddings: fake (offline) or openai_compat (gemini-embedding-001, 768 dims)
EMBED_PROVIDER=fake
# JWT_SECRET=change-me-to-32+-random-bytes
